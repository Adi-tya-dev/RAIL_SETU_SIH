PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/railway_block_planning?schema=public"

ALGORITHM_DIR=
ALGORITHM_ENTRY=
ALGORITHM_TIMEOUT_MS=30000

# Source data integration (TMS / SMMS / TDMS / COA)
# SOURCE_MODE controls whether the adapters talk to a simulator or a live API.
# The simulator explicitly labels every payload as SIMULATOR prototype data.
SOURCE_MODE=SIMULATOR
SOURCE_FETCH_TIMEOUT_MS=5000